else
  export NODE_PATH="/Users/raphael.balet/Documents/Open-source/structures/node_modules/.pnpm/vitest@3.2.7_@types+debug@4.1.13_@types+node@26.2.0_jiti@2.7.0_jsdom@29.0.0_@noble+hash_626fce852754a0d54463504aee0b22e1/node_modules/vitest/node_modules:/Users/raphael.balet/Documents/Open-source/structures/node_modules/.pnpm/vitest@3.2.7_@types+debug@4.1.13_@types+node@26.2.0_jiti@2.7.0_jsdom@29.0.0_@noble+hash_626fce852754a0d54463504aee0b22e1/node_modules:/Users/raphael.balet/Documents/Open-source/structures/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -n "$exe" ] && [ -x "$basedir/node.exe" ]; then
  exec "$basedir/node.exe"  "$basedir_win/../vitest/vitest.mjs" "$@"
elif [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../vitest/vitest.mjs" "$@"
elif command -v node >/dev/null 2>&1; then
  exec node  "$basedir/../vitest/vitest.mjs" "$@"
elif [ -n "$exe" ] && command -v node.exe >/dev/null 2>&1; then
  exec node.exe  "$basedir_win/../vitest/vitest.mjs" "$@"
else
  exec node  "$basedir/../vitest/vitest.mjs" "$@"
fi
